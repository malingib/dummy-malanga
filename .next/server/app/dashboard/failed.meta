{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/failed/layout,_N_T_/dashboard/failed/page,_N_T_/dashboard/failed"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/failed/__PAGE__",
    "/dashboard/failed",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}