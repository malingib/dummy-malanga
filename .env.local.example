# Neon PostgreSQL — server side only.
# Use the pooled or direct Neon connection string. Never expose it to Vite.
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/mobipay?sslmode=require
# Optional: fail-fast timeout for database connection/query calls (milliseconds).
DATABASE_REQUEST_TIMEOUT_MS=8000
# Optional: maximum PostgreSQL pool size (default 10).
# DATABASE_POOL_MAX=10
# Optional: set to "disable" only for a local PostgreSQL instance without TLS.
# DATABASE_SSL=disable

# M-Pesa Daraja
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
MPESA_INITIATOR_NAME=your_initiator_name
MPESA_INITIATOR_PASSWORD=your_initiator_password
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=https://your-domain.example/api/mpesa/confirmation

# MobiPay regulatory / licensed PSP boundary
# sandbox_direct is for development/testing only.
# production payment initiation requires partner_psp + verified PSP configuration.
MOBIPAY_OPERATING_MODE=sandbox_direct
PSP_PROVIDER_ID=your_licensed_psp_identifier
PSP_LICENSE_STATUS=unverified

# MobiWave SMS — server side only
MOBIWAVE_SMS_API_URL=https://sms.mobiwave.co.ke/api/v3
MOBIWAVE_SMS_API_TOKEN=your_mobiwave_sms_api_token
MOBIWAVE_SMS_SENDER_ID=MobiWave

# Application
PORT=4000
HOST=0.0.0.0
PUBLIC_API_ORIGIN=http://localhost:4000
PUBLIC_API_PROTOCOL=http
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated browser origins are supported for multi-frontend deployments.
# CORS_ORIGIN=https://portal.example.com,https://admin.example.com
MAX_BODY_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
HEADER_TIMEOUT_MS=10000
# Optional: per-IP, per-minute admin read and sign-in limits.
# RATE_LIMIT_MAX_ADMIN=240
# RATE_LIMIT_MAX_ADMIN_LOGIN=20
CALLBACK_VALIDATION_TOKEN=your_secure_token
CRON_SECRET=replace_with_a_long_random_secret
WEBHOOK_ENCRYPTION_KEY=base64_encoded_32_byte_key
# Platform administrator console (/admin). Separate from merchant workspace sessions.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
PLATFORM_ADMIN_NAME=Platform administrator
# Optional. Defaults to ADMIN_PASSWORD; rotate to invalidate existing admin sessions.
PLATFORM_ADMIN_SESSION_SECRET=replace_with_a_long_random_secret
