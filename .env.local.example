# Supabase — server side
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# M-Pesa Daraja
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
MPESA_INITIATOR_NAME=your_initiator_name
MPESA_INITIATOR_PASSWORD=your_initiator_password
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=https://your-domain.example/api/mpesa/confirmation

# MobiWave SMS — server side only
MOBIWAVE_SMS_API_URL=https://sms.mobiwave.co.ke/api/v3
MOBIWAVE_SMS_API_TOKEN=your_mobiwave_sms_api_token
MOBIWAVE_SMS_SENDER_ID=MobiWave

# Application
PORT=4000
HOST=0.0.0.0
PUBLIC_API_ORIGIN=http://localhost:4000
PUBLIC_API_PROTOCOL=http
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated browser origins are supported for multi-frontend deployments.
# CORS_ORIGIN=https://portal.example.com,https://admin.example.com
MAX_BODY_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
HEADER_TIMEOUT_MS=10000
CALLBACK_VALIDATION_TOKEN=your_secure_token
CRON_SECRET=replace_with_a_long_random_secret
WEBHOOK_ENCRYPTION_KEY=base64_encoded_32_byte_key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
