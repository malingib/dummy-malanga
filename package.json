{
  "name": "mobipay",
  "version": "2.0.0",
  "description": "MobiPay merchant payments platform with standalone Node API and React/Vite frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:backend": "tsx server/index.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "start": "tsx server/index.ts",
    "lint": "tsc --noEmit",
    "test:mpesa": "node --test tests/mpesa-callback-rules.test.mjs",
    "audit:architecture": "node scripts/architecture-audit.mjs",
    "verify": "npm run audit:architecture && npm run lint && npm run test:mpesa && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "autoprefixer": "^10.4.0",
    "axios": "^1.6.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.10.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.4",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-color": "^3.1.0",
    "@types/d3-ease": "^3.0.0",
    "@types/d3-interpolate": "^3.0.0",
    "@types/d3-path": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-time": "^3.0.0",
    "@types/d3-timer": "^3.0.0",
    "@types/estree": "^1.0.8",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "eslint": "^9.0.0",
    "typescript": "^5.9.3"
  }
}
